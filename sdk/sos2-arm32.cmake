# Source builds for SOS2's native ARM32 runtime. No target Linux search paths.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER arm-none-eabi-gcc)
set(CMAKE_CXX_COMPILER arm-none-eabi-g++)
set(CMAKE_ASM_COMPILER arm-none-eabi-gcc)
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(SOS2_NATIVE_TARGET TRUE CACHE BOOL "Build for SOS2's native runtime")
get_filename_component(SOS2_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SOS2_NATIVE "${SOS2_ROOT}/build/native-toolchain")
set(CMAKE_SYSROOT "${SOS2_NATIVE}/install/arm-none-eabi")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# ARMv7 code that QEMU's Cortex-A15 runs, scheduled for the phone's in-order Cortex-A53.
set(_SOS2_FLAGS "-marm -mcpu=cortex-a15 -mtune=cortex-a53 -mfpu=neon-vfpv4 -mfloat-abi=hard -ffunction-sections -fdata-sections -I${SOS2_ROOT}/sdk/include -I${SOS2_ROOT}/include -isystem ${CMAKE_SYSROOT}/include -include ${SOS2_ROOT}/sdk/include/sos2/features.h")
set(CMAKE_C_FLAGS_INIT "${_SOS2_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "-isystem ${CMAKE_SYSROOT}/include/c++/14.2.0 -isystem ${CMAKE_SYSROOT}/include/c++/14.2.0/arm-none-eabi ${_SOS2_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -nostartfiles -T${SOS2_ROOT}/sdk/runtime/linker.ld -Wl,-z,max-page-size=4096,-z,noexecstack,--gc-sections -L${CMAKE_SYSROOT}/lib -Wl,--whole-archive ${SOS2_NATIVE}/sdk/libsos2.a -Wl,--no-whole-archive")
set(CMAKE_C_STANDARD_LIBRARIES "-Wl,--start-group -lc -lm -lgcc -Wl,--end-group")
set(CMAKE_CXX_STANDARD_LIBRARIES "-Wl,--start-group -lstdc++ -lc -lm -lgcc -Wl,--end-group")
