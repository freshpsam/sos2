+#elif defined(__sos2__)
+
+#include <errno.h>
+#include <time.h>
+#include <sos2/services.h>
+
+int futex_wake(uint32_t *addr, int32_t count)
+{
+   sos2_wake(addr, count < 0 ? 0u : (unsigned)count);
+   return 0;
+}
+
+/* The timeout is absolute on CLOCK_MONOTONIC, as with Linux's
+ * FUTEX_WAIT_BITSET; an SOS2 wait takes microseconds from now. */
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   uint32_t us = USER_WAIT_FOREVER;
+   if (timeout) {
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      int64_t left = ((int64_t)timeout->tv_sec - now.tv_sec) * 1000000 +
+                     (timeout->tv_nsec - now.tv_nsec) / 1000;
+      if (left <= 0) {
+         errno = ETIMEDOUT;
+         return -1;
+      }
+      us = left >= USER_WAIT_FOREVER ? USER_WAIT_FOREVER - 1 : (uint32_t)left;
+   }
+   int result = sos2_wait(addr, (uint32_t)value, us);
+   if (result >= 0)
+      return 0;
+   errno = sos2_errno(result);
+   return -1;
+}
+
