+// SOS2: one relaxed read of a value profile bucket. decodeConcurrent() reads
+// with sequential consistency, which on 32-bit ARM puts a barrier on both
+// sides of every load. Value profiles are updated on the mutator or with the
+// world stopped, holding valueProfileLock(), so no other thread writes a
+// bucket meanwhile, which is what makes this safe: the load is the LDRD of
+// decodeConcurrent(), atomic only with LPAE, and the Krait cores have none.
+static ALWAYS_INLINE JSValue readValueProfileBucket(const EncodedJSValue& bucket)
+{
+#if USE(JSVALUE32_64) && ENABLE(CONCURRENT_JS)
+    for (;;) {
+        JSValue value = JSValue::decode(reinterpret_cast<const std::atomic<EncodedJSValue>*>(&bucket)->load(std::memory_order_relaxed));
+        if (value.tag() != JSValue::InvalidTag)
+            return value;
+    }
+#else
+    return JSValue::decode(bucket);
+#endif
+}
