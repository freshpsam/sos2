@@ -55,6 +63,42 @@ void AlignedMemoryAllocator::registerSubspace(Subspace* subspace)
     m_subspaces.append(std::mem_fn(&Subspace::setNextSubspaceInAlignedMemoryAllocator), subspace);
 }
 
+#if OS(SOS2)
+
+// Each block is a mapping of its own, which the kernel aligns (MAP_ALIGNED),
+// and up to 16 freed blocks are kept for reuse: SOS2 frees memory only when it
+// is unmapped, and unmapping pauses the process's other threads.
+static constexpr unsigned sos2CachedBlocks = 16;
+static Lock sos2BlockLock;
+static void* sos2FreeBlocks[sos2CachedBlocks];
+static unsigned sos2FreeBlockCount;
+
+void* tryAllocateSOS2Block()
+{
+    {
+        Locker locker { sos2BlockLock };
+        if (sos2FreeBlockCount)
+            return sos2FreeBlocks[--sos2FreeBlockCount];
+    }
+    void* memory = mmap(nullptr, MarkedBlock::blockSize, PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANON | MAP_ALIGNED(std::countr_zero(MarkedBlock::blockSize)), -1, 0);
+    return memory == MAP_FAILED ? nullptr : memory;
+}
+
+void freeSOS2Block(void* block)
+{
+    {
+        Locker locker { sos2BlockLock };
+        if (sos2FreeBlockCount < sos2CachedBlocks) {
+            sos2FreeBlocks[sos2FreeBlockCount++] = block;
+            return;
+        }
+    }
+    munmap(block, MarkedBlock::blockSize);
+}
+
+#endif // OS(SOS2)
+
 } // namespace JSC
 
 
