+#pragma once
+
+#if OS(SOS2)
+
+namespace JSC {
+
+// MarkedBlocks on SOS2 (AlignedMemoryAllocator.cpp). SOS2 commits every
+// mapping, and mimalloc serves a block aligned beyond 4 KiB from an OS
+// allocation with a page header and alignment slack: 32 KiB per 16 KiB block.
+// These map each block exactly instead.
+void* tryAllocateSOS2Block();
+void freeSOS2Block(void*);
+
+} // namespace JSC
+
+#endif // OS(SOS2)
