 namespace JSC { 
 
 AlignedMemoryAllocator::AlignedMemoryAllocator() = default;
@@ -55,6 +63,52 @@ void AlignedMemoryAllocator::registerSubspace(Subspace* subspace)
     m_subspaces.append(std::mem_fn(&Subspace::setNextSubspaceInAlignedMemoryAllocator), subspace);
 }
 
+#if OS(SOS2)
+
+// Each block is mapped on its own, with mmap's page-aligned slack unmapped
+// around it, and up to 16 freed blocks are kept for reuse: SOS2 frees memory
+// only when it is unmapped, and each mapping change pauses the process's other
+// threads.
+static constexpr unsigned sos2CachedBlocks = 16;
+static Lock sos2BlockLock;
+static void* sos2FreeBlocks[sos2CachedBlocks];
+static unsigned sos2FreeBlockCount;
+
+void* tryAllocateSOS2Block()
+{
+    {
+        Locker locker { sos2BlockLock };
+        if (sos2FreeBlockCount)
+            return sos2FreeBlocks[--sos2FreeBlockCount];
+    }
+    size_t mapped = 2 * MarkedBlock::blockSize - pageSize();
+    void* memory = mmap(nullptr, mapped, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (memory == MAP_FAILED)
+        return nullptr;
+    uintptr_t start = reinterpret_cast<uintptr_t>(memory);
+    uintptr_t block = roundUpToMultipleOf<MarkedBlock::blockSize>(start);
+    uintptr_t end = block + MarkedBlock::blockSize;
+    if (block != start)
+        munmap(memory, block - start);
+    if (start + mapped != end)
+        munmap(reinterpret_cast<void*>(end), start + mapped - end);
+    return reinterpret_cast<void*>(block);
+}
+
+void freeSOS2Block(void* block)
+{
+    {
+        Locker locker { sos2BlockLock };
+        if (sos2FreeBlockCount < sos2CachedBlocks) {
+            sos2FreeBlocks[sos2FreeBlockCount++] = block;
+            return;
+        }
+    }
+    munmap(block, MarkedBlock::blockSize);
+}
+
+#endif // OS(SOS2)
+
 } // namespace JSC
 
 
