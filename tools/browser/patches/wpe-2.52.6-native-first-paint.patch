 }
 
+#if OS(SOS2)
+// The browser draws frames between turns of the event loop, and parsing goes
+// on at the next one, so a script that holds the parser hid what came before
+// it until it ended: YouTube's skeleton, 8 s on a Nexus 5. A layout, which
+// isVisuallyNonEmpty() needs, had not run either. Before such a script the
+// parser waits for a frame, a few times a load.
+bool HTMLParserScheduler::shouldWaitForFrame(Document& document, const ScriptElement* script, PumpSession& session)
+{
+    constexpr unsigned frameWaitsPerDocument = 3;
+    constexpr unsigned longInlineScript = 1024;
+    if (m_frameWaits >= frameWaitsPerDocument || !script || script->hasAsyncAttribute() || script->hasDeferAttribute())
+        return false;
+    if (!script->hasSourceAttribute() && script->scriptContent().length() < longInlineScript)
+        return false;
+    RefPtr page = document.page();
+    if (!page || !page->isVisible() || !document.frame()->isMainFrame())
+        return false;
+    if (!parsingProgressedSinceLastYield(session))
+        return false;
+    ++m_frameWaits;
+    m_frameWaitStart = MonotonicTime::now();
+    return true;
+}
+#endif
+
 bool HTMLParserScheduler::shouldYieldBeforeExecutingScript(const ScriptElement* scriptElement, PumpSession& session)
 {
     // If we've never painted before and a layout is pending, yield prior to running
@@ -144,6 +185,11 @@
     if (m_documentHasActiveParserYieldTokens) [[unlikely]]
         return true;
 
+#if OS(SOS2)
+    if (shouldWaitForFrame(*document, scriptElement, session))
+        return true;
+#endif
+
     // Yield if we have never painted and there is meaningful content
     if (document->view() && !document->view()->hasEverPainted() && document->view()->isVisuallyNonEmpty())
         return parsingProgressedSinceLastYield(session);
