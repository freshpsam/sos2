@@ -697,7 +697,14 @@ bool ThreadCondition::timedWait(Mutex& mutex, WallTime absoluteTime)
         return true;
     }
 
+#if OS(SOS2)
+    // ParkingLot converts its deadlines to approximate wall time for this API.
+    // Keep the actual wait on SOS2's available monotonic clock, including when
+    // no calibrated RTC exists. Do not turn a missing RTC into a busy loop.
+    double rawSeconds = (MonotonicTime::now() + (absoluteTime - WallTime::now())).secondsSinceEpoch().value();
+#else
     double rawSeconds = absoluteTime.secondsSinceEpoch().value();
+#endif
 
     time_t timeSeconds = static_cast<time_t>(rawSeconds);
     long timeNanoseconds = static_cast<long>((rawSeconds - timeSeconds) * 1E9);
@@ -706,7 +713,11 @@ bool ThreadCondition::timedWait(Mutex& mutex, WallTime absoluteTime)
     targetTime.tv_sec = timeSeconds;
     targetTime.tv_nsec = timeNanoseconds;
 
+#if OS(SOS2)
+    return pthread_cond_clockwait(&m_condition, &mutex.impl(), CLOCK_MONOTONIC, &targetTime) == 0;
+#else
     return pthread_cond_timedwait(&m_condition, &mutex.impl(), &targetTime) == 0;
+#endif
